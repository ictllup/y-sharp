# ---------- Y-Sharp configuration (all optional) ----------

# Where downloaded files land. Use a persistent disk on your host if you want
# files to survive restarts. Default: /tmp/ysharp
YSHARP_DATA_DIR=/tmp/ysharp

# Seconds a finished file is kept before the janitor deletes it. Default 1800.
YSHARP_FILE_TTL=1800

# Parallel downloads. Each one is a yt-dlp process — 2 is plenty on a small box.
YSHARP_MAX_CONCURRENT=2

# Refuse jobs beyond this queue depth (protects a shared server).
YSHARP_MAX_QUEUE=25

# Reject videos longer than this many seconds (default 4h).
YSHARP_MAX_DURATION=14400

# Refuse files bigger than this many MB (default 2 GB).
YSHARP_MAX_FILESIZE_MB=2048

# Requests per minute per IP. 0 disables limiting.
YSHARP_RATE_LIMIT=20

# Allow playlist URLs (downloads the first entry only unless you extend the engine).
YSHARP_ALLOW_PLAYLISTS=false

# --- Cloud survival kit -------------------------------------------------
# YouTube often demands proof of humanity from datacenter IPs. Export cookies
# with a browser extension ("Get cookies.txt LOCALLY"), then either:
#   YSHARP_COOKIEFILE=/path/to/cookies.txt
#   YSHARP_COOKIES_B64=$(base64 -w0 cookies.txt)     # best for secret stores
# YSHARP_COOKIES_B64=
# YSHARP_PROXY=http://user:pass@host:port

# YouTube player-client order. On blocked datacenter IPs the Android client
# can provide a restricted progressive stream (often up to 360p); cookies may
# be needed for higher resolutions. Default: default,android
YSHARP_YT_CLIENTS=default,android

# Optional BgUtils PO-token provider HTTP service, if you run one separately.
# This is not a bot-check bypass by itself. Leave unset for the built-in fallback.
# YSHARP_POT_BASE_URL=http://127.0.0.1:4416

# Force a specific binary if auto-detection guesses wrong.
# FFMPEG_LOCATION=/usr/bin/ffmpeg
# YSHARP_JS_RUNTIME=node
